# Copy this to .env and fill in what you have. Everything here is optional.
# Without any of it the project still runs: SALAH falls back to rule based
# recommendations and tracing becomes a no op.

# SALAH next best action agent. Set ONE of these to get real LLM recommendations.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# SALAH_MODEL=claude-sonnet-4-20250514

# Langfuse observability. Set both keys to trace predictions and LLM calls.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Pipeline reference date (the "today" the model scores for). Optional.
# KSHETRA_REF_DATE=2026-01-15
